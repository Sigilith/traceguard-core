            "agent_id": agent_name,
            "drift_score": round(drift_score, 3),
            "drift_state": drift_state,
            "violations": recent_violations,
            "timestamp": int(time.time())
        }
        
        # Cryptographically sign or seal the payload footprint
        raw_json = json.dumps(payload, sort_keys=True)
