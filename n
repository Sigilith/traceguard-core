import time
import json
from pathlib import Path
import paho.mqtt.client as mqtt

# Configuration (Public Sandbox Test)
RECEIPTS_DIR = Path(".lineage/derek_receipts")
POLL_INTERVAL = 2  # seconds
BROKER = "broker.hivemq.com"
PORT = 1883
TOPIC = "threelineage/mesh/containment"

def on_connect(client, userdata, flags, rc):
    if rc == 0:
        print(f"[+] Connected to Public Sandbox Broker: {BROKER}")
    else:
        print(f"[-] Mesh connection failed with code {rc}")

def on_publish(client, userdata, mid):
    print(f"[+] Receipt broadcasted successfully to mesh topic: {TOPIC}")

def start_mqtt_daemon():
    print("[*] Starting Sentinel Mesh MQTT Broadcast Daemon...")
    print(f"[*] Watching: {RECEIPTS_DIR}")
    
    if not RECEIPTS_DIR.exists():
        RECEIPTS_DIR.mkdir(parents=True, exist_ok=True)

    client = mqtt.Client(client_id="derek_node_alpha")
    client.on_connect = on_connect
    client.on_publish = on_publish
    
    # No TLS or credentials needed for the public sandbox test broker
    try:
        client.connect(BROKER, PORT, 60)
        client.loop_start()
    except Exception as e:
        print(f"[CRITICAL] Could not connect to broker: {e}")
        return

    processed = {f.name for f in RECEIPTS_DIR.glob("*.json")}
    print(f"[*] Found {len(processed)} existing receipts. Monitoring for new events.")

    try:
        while True:
            current_files = {f.name for f in RECEIPTS_DIR.glob("*.json")}
            new_files = current_files - processed

            for file_name in new_files:
                file_path = RECEIPTS_DIR / file_name
                print(f"\n[!] New containment receipt detected: {file_name}")
                
                try:
                    payload = file_path.read_text()
                    client.publish(TOPIC, payload, qos=1)
                    processed.add(file_name)
                except Exception as e:
                    print(f"[-] Failed to broadcast receipt {file_name}: {e}")

            time.sleep(POLL_INTERVAL)
            
    except KeyboardInterrupt:
        print("\n[*] Sentinel Mesh MQTT Broadcast Daemon halted.")
        client.loop_stop()
        client.disconnect()

if __name__ == "__main__":
    start_mqtt_daemon()
	

